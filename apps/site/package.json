{
  "name": "@cloudoptics/site",
  "private": true,
  "version": "0.0.0",
  "description": "The public Cloudoptics site: landing, how it works, security (docs/14, ADR-016).",
  "type": "module",
  "scripts": {
    "permissions": "node scripts/build-permissions.mjs",
    "dev": "node scripts/build-permissions.mjs && astro dev",
    "build": "node scripts/build-permissions.mjs && astro build",
    "preview": "astro preview --port 4321",
    "typecheck": "node scripts/build-permissions.mjs && astro check",
    "lint": "oxlint --deny-warnings src scripts tests",
    "test": "node --test \"tests/*.test.mjs\"",
    "size": "node scripts/check-dist.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "og-image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@cloudoptics/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.13",
    "axe-core": "^4.14.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  }
}
