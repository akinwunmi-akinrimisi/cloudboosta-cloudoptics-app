---
// Native <details> list (docs/14 §8.2): keyboard and screen-reader friendly with no script.
import type { FaqItem } from '../data/faq'
import Icon from './Icon.astro'

interface Props {
  items: FaqItem[]
  headingLevel?: 'h2' | 'h3'
  title?: string
  id?: string
  /** The roman numeral in the margin. */
  no?: string
}
const { items, headingLevel = 'h2', title = 'Questions people ask first', id = 'faq', no } = Astro.props
const Heading = headingLevel
---

<section id={id} aria-labelledby={`${id}-title`} class="sec">
  <div class="wrap sec-grid">
    <div class="margin">{no && <span class="no" aria-hidden="true">{no}</span>}<span class="kicker">Questions</span></div>
    <div>
      <Heading id={`${id}-title`}>{title}</Heading>
      <div class="faq">
        {
          items.map((item) => (
            <details id={item.id}>
              <summary>
                {item.q}
                <Icon name="plus" />
              </summary>
              <div class="answer">
                {item.a.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
