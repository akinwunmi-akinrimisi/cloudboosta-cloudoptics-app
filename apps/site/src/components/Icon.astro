---
// A few Lucide icons (ISC licence, docs/08 §2.8), inlined so pages load no icon font or script.
type Name = 'check' | 'x' | 'arrow-right' | 'external'
interface Props {
  name: Name
  class?: string
}
const { name, class: cls = 'h-4 w-4' } = Astro.props
const paths: Record<Name, string[]> = {
  check: ['M20 6 9 17l-5-5'],
  x: ['M18 6 6 18', 'm6 6 12 12'],
  'arrow-right': ['M5 12h14', 'm12 5 7 7-7 7'],
  external: ['M15 3h6v6', 'M10 14 21 3', 'M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6'],
}
---

<svg
  class={`inline-block shrink-0 ${cls}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false">{paths[name].map((d) => <path d={d} />)}</svg
>
