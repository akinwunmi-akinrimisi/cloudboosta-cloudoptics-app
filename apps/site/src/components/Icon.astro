---
// Lucide icons (ISC licence, docs/08 §2.8), inlined so pages load no icon font or script.
// Decorative: the text next to an icon always says what it means.
import { type IconName, paths } from './icons'

interface Props {
  name: IconName
  class?: string
}
const { name, class: cls = '' } = Astro.props
---

<svg
  class={`ico ${cls}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false">{paths[name].map((d) => <path d={d} />)}</svg
>
