---
// A product screenshot from the demo build, always labelled "Sample data" (docs/14 §8.1).
// AVIF with a WebP fallback and a responsive srcset (§8.3). The alt text says what the screen
// shows; key numbers are repeated in the page text.
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
  eager?: boolean
  widths?: number[]
}
const { src, alt, caption, eager = false, widths = [480, 800, 1200] } = Astro.props
---

<figure class="overflow-hidden rounded-md border border-border bg-surface-1 shadow-sm">
  <Picture
    src={src}
    alt={alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={widths.filter((w) => w <= src.width)}
    sizes="(min-width: 1024px) 560px, 100vw"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class="h-auto w-full"
  />
  <figcaption class="flex items-center gap-2 border-t border-border px-4 py-2 text-xs text-secondary">
    <span class="rounded-sm bg-brand-yellow px-1.5 py-0.5 font-semibold text-brand-navy">Sample data</span>
    {caption}
  </figcaption>
</figure>
