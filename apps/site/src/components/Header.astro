---
// Header (docs/14 §4.2). The mobile menu is a native <details>, so it works without JavaScript.
import { DEMO_URL, SIGN_IN_URL, START_URL } from '../config'
import Logo from './Logo.astro'

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/security', label: 'Security' },
  { href: '/#pricing', label: 'Pricing' },
  { href: DEMO_URL, label: 'Demo' },
]
const current = (href: string) => (href === path ? 'page' : undefined)
---

<header class="sticky top-0 z-40 border-b border-border bg-surface-1">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="rounded-sm" aria-label="Cloudoptics by Cloudboosta, home"><Logo /></a>
    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={current(l.href)}
            class="rounded-sm px-3 py-2 text-sm font-medium text-secondary hover:text-primary aria-[current=page]:text-link"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="hidden items-center gap-2 md:flex">
      <a href={SIGN_IN_URL} class="rounded-sm px-3 py-2 text-sm font-medium text-primary hover:text-link">Sign in</a>
      <a href={START_URL} class="rounded-sm bg-accent px-4 py-2 text-sm font-semibold text-on-accent hover:bg-accent-hover">
        Start free
      </a>
    </div>
    <details class="relative md:hidden">
      <summary
        class="flex min-h-11 min-w-11 list-none items-center justify-center rounded-sm border border-border-strong px-3 text-sm font-medium [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <nav aria-label="Main (mobile)" class="absolute right-0 mt-2 w-64 rounded-md border border-border bg-surface-1 p-2 shadow-lg">
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={current(l.href)} class="flex min-h-11 items-center rounded-sm px-3 text-primary">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li><a href={SIGN_IN_URL} class="flex min-h-11 items-center rounded-sm px-3 text-primary">Sign in</a></li>
          <li>
            <a href={START_URL} class="mt-1 flex min-h-11 items-center justify-center rounded-sm bg-accent px-3 font-semibold text-on-accent">
              Start free
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
