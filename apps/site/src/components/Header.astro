---
// Masthead (docs/14 §4.2): a dateline strip, then the sticky header. The mobile menu is a native
// <details>, so it works without JavaScript.
import { DEMO_URL, SIGN_IN_URL, START_URL, claims } from '../config'
import Logo from './Logo.astro'

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/security', label: 'Security' },
  { href: '/#pricing', label: 'Pricing' },
  { href: DEMO_URL, label: 'Demo' },
]
const current = (href: string) => (href === path ? 'page' : undefined)
// The countries whose currency the sample figures can switch to.
const rates = claims.sampleRates as Record<string, number>
const countries = claims.localCurrencies.filter((c) => c.code in rates).map((c) => c.country)
---

<aside class="strip" aria-label="At a glance">
  <div class="wrap"><span>{claims.pricing.headline} · No card needed</span><span>{countries.join(' · ')}</span></div>
</aside>
<header class="top">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Cloudoptics by Cloudboosta, home"><Logo /></a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <a class="signin" href={SIGN_IN_URL}>Sign in</a>
      <a class="btn btn-primary" href={START_URL}>Start free</a>
      <details class="menu">
        <summary>Menu</summary>
        <nav aria-label="Main (mobile)">
          {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
          <a href={SIGN_IN_URL}>Sign in</a>
          <a href={START_URL}>Start free</a>
        </nav>
      </details>
    </div>
  </div>
</header>
