---
// One role's permissions, generated from the template and permissions.yaml (SITE-08).
// detail="full" adds the exact actions and the resources they apply to (/security#permissions).
// Below 860 px each row becomes a stacked record (data-label names the column), so the page never
// scrolls sideways.
import { permissions } from '../config'

type Role = (typeof permissions.roles)[number]
interface Props {
  role: Role
  detail?: 'summary' | 'full'
  headingLevel?: 'h3' | 'h4'
}
const { role, detail = 'summary', headingLevel = 'h3' } = Astro.props
const Heading = headingLevel
const anchor = `role-${role.logicalId.toLowerCase()}`
const scope = (resources: string[]) =>
  resources.includes('*') ? 'Any resource (the action has no narrower scope, or reads account-wide lists)' : null
---

<section aria-labelledby={anchor} class="role">
  <div class="role-head">
    <Heading id={anchor}>
      {role.title}{role.roleName && <>: <code>{role.roleName}</code></>}
    </Heading>
    <span class="count">{role.readOnly ? 'Read only' : 'Setup only'} · {role.actionCount} actions</span>
  </div>
  <p class="summary">{role.summary} Used by: {role.usedBy.replace(/\.$/, '')}.</p>
  <table class="dtable">
    <caption class="sr-only">Permissions of the {role.title.toLowerCase()}</caption>
    <thead>
      <tr>
        {detail === 'full' && <th scope="col">AWS actions</th>}
        <th scope="col">In plain language</th>
        <th scope="col">Used for</th>
        {detail === 'full' && <th scope="col">Applies to</th>}
      </tr>
    </thead>
    <tbody>
      {
        role.groups.map((g) => (
          <tr>
            {detail === 'full' && (
              <td data-label="AWS actions">
                <ul>
                  {g.actions.map((a) => (
                    <li>
                      <code>{a}</code>
                    </li>
                  ))}
                </ul>
              </td>
            )}
            <td data-label="In plain language">{g.plain}</td>
            <td data-label="Used for" class="muted">
              {g.usedFor}
            </td>
            {detail === 'full' && (
              <td data-label="Applies to" class="muted">
                {scope(g.resources) ?? (
                  <ul>
                    {g.resources.map((r) => (
                      <li>
                        <code>{r}</code>
                      </li>
                    ))}
                  </ul>
                )}
              </td>
            )}
          </tr>
        ))
      }
      {
        detail === 'full' &&
          role.managedPolicies.map((m) => (
            <tr>
              <td data-label="AWS actions">
                <code>{m.policy}</code> (AWS managed policy)
              </td>
              <td data-label="In plain language">{m.plain}</td>
              <td data-label="Used for" class="muted">
                The setup function's logs.
              </td>
              <td data-label="Applies to" class="muted">
                CloudWatch Logs in your account
              </td>
            </tr>
          ))
      }
    </tbody>
  </table>
</section>
