---
// Footer (docs/14 §4.2): the same links on every page, a support line in the same place once the
// channel is decided (WCAG 3.2.6; docs/14 §11 Q10), and the AWS trademark notice.
import { DEMO_URL, SIGN_IN_URL, START_URL, TEMPLATE_URL, claims } from '../config'
import Logo from './Logo.astro'

const support = claims.support as { label: string; href: string; hours?: string } | null
const year = new Date().getFullYear()
const link = 'inline-flex min-h-6 items-center text-navy-muted hover:text-white'
---

<footer class="on-navy mt-20 bg-brand-navy text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <Logo tone="navy" />
      <p class="mt-4 max-w-sm text-sm text-navy-muted">
        AWS cost optimisation for African teams, in US dollars and your local currency. Read-only access.
      </p>
      {
        support && (
          <p class="mt-4 text-sm">
            Support: <a href={support.href} class="text-blue-on-navy underline">{support.label}</a>
            {support.hours && <span class="text-navy-muted"> · {support.hours}</span>}
          </p>
        )
      }
    </div>
    <nav aria-label="Product">
      <h2 class="text-sm font-semibold">Product</h2>
      <ul class="mt-3 space-y-1 text-sm">
        <li><a class={link} href="/how-it-works">How it works</a></li>
        <li><a class={link} href="/#pricing">Pricing</a></li>
        <li><a class={link} href={DEMO_URL}>Demo (sample data)</a></li>
        <li><a class={link} href={START_URL}>Start free</a></li>
        <li><a class={link} href={SIGN_IN_URL}>Sign in</a></li>
      </ul>
    </nav>
    <nav aria-label="Trust">
      <h2 class="text-sm font-semibold">Trust</h2>
      <ul class="mt-3 space-y-1 text-sm">
        <li><a class={link} href="/security">Security</a></li>
        <li><a class={link} href="/security#permissions">Every permission</a></li>
        <li><a class={link} href="/how-it-works#what-the-stack-creates">What the stack creates</a></li>
        <li><a class={link} href={TEMPLATE_URL}>Download the template</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/20">
    <div class="mx-auto max-w-6xl space-y-1 px-4 py-6 text-xs text-navy-muted sm:px-6">
      <p>© {year} Cloudboosta. Cloudoptics is a Cloudboosta product.</p>
      <p>
        Cloudoptics is not affiliated with or endorsed by Amazon Web Services. AWS and related marks are trademarks of
        Amazon.com, Inc. or its affiliates.
      </p>
    </div>
  </div>
</footer>
