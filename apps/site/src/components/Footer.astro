---
// Footer (docs/14 §4.2): the same links on every page, a support line in the same place once the
// channel is decided (WCAG 3.2.6; docs/14 §11 Q10), and the AWS trademark notice.
import { DEMO_URL, SIGN_IN_URL, START_URL, TEMPLATE_URL, claims } from '../config'
import Logo from './Logo.astro'

const support = claims.support as { label: string; href: string; hours?: string } | null
const year = new Date().getFullYear()
---

<footer class="foot">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Cloudoptics by Cloudboosta, home"><Logo /></a>
    <nav aria-label="Footer">
      <a href="/how-it-works">How it works</a>
      <a href="/security">Security</a>
      <a href="/security#permissions">Every permission</a>
      <a href="/how-it-works#what-the-stack-creates">What the stack creates</a>
      <a href={TEMPLATE_URL}>The template</a>
      <a href="/#pricing">Pricing</a>
      <a href={DEMO_URL}>Demo (sample data)</a>
      <a href={START_URL}>Start free</a>
      <a href={SIGN_IN_URL}>Sign in</a>
    </nav>
    <div class="legal">
      {
        support && (
          <p>
            Support: <a href={support.href}>{support.label}</a>
            {support.hours && <span> · {support.hours}</span>}
          </p>
        )
      }
      <p>Sample figures use illustrative exchange rates. © {year} Cloudboosta. Cloudoptics is a Cloudboosta product.</p>
      <p>Not affiliated with or endorsed by Amazon Web Services. AWS and related marks are trademarks of Amazon.com, Inc. or its affiliates.</p>
    </div>
  </div>
</footer>
