---
// "How it works" (docs/14 §5.2) in design Direction A: the onboarding, described for the person
// who will do it, and the page a DevOps lead forwards to a security reviewer. Step names and times
// come from the claims file; names, region and permissions from the template.
import Faq from '../components/Faq.astro'
import Icon from '../components/Icon.astro'
import StackResources from '../components/StackResources.astro'
import { START_URL, TEMPLATE_URL, billingRole, claims, facts, resourceRole } from '../config'
import { never, readActionCount, reads } from '../data/access'
import { HOW_FAQ } from '../data/faq'
import Base from '../layouts/Base.astro'

const [stepWorkspace, stepConnect, stepCheck] = claims.wizardSteps
const title = 'How Cloudoptics works: connect AWS in about 15 minutes'
const description = `What happens when you connect AWS to Cloudoptics, step by step: one CloudFormation stack in ${facts.region}, read-only roles, and how to remove it.`

const sections = [
  { id: 'before-you-start', label: 'Before you start' },
  { id: 'step-1', label: `Step 1: ${stepWorkspace}` },
  { id: 'step-2', label: `Step 2: ${stepConnect}` },
  { id: 'what-the-stack-creates', label: 'What the stack creates' },
  { id: 'step-3', label: `Step 3: ${stepCheck}` },
  { id: 'afterwards', label: 'What you see afterwards' },
  { id: 'permissions', label: 'Permissions, in plain language' },
  { id: 'aws-costs', label: 'What it costs you in AWS' },
  { id: 'removing-access', label: 'Removing and updating access' },
  { id: 'faq', label: 'Security questions' },
]
---

<Base title={title} description={description} faq={HOW_FAQ}>
  <section class="page-hero" aria-labelledby="h1">
    <div class="wrap">
      <div>
        <span class="kicker">How it works</span>
        <h1 id="h1">Connect AWS in about <em>{claims.setupMinutes} minutes</em>.</h1>
        <p class="intro">Three steps, most of it waiting for AWS: {stepWorkspace.toLowerCase()}, {stepConnect.toLowerCase()}, {stepCheck.toLowerCase()}.</p>
      </div>
      <nav class="toc" aria-labelledby="on-this-page">
        <h2 id="on-this-page" class="sr-only">On this page</h2>
        <ol>{sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}</ol>
      </nav>
    </div>
  </section>

  <section id="before-you-start" class="sec" aria-labelledby="before-you-start-title">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">i.</span><span class="kicker">Checklist</span></div>
      <div>
        <h2 id="before-you-start-title">Before you start</h2>
        <ul class="ruled">
          <li><Icon name="check" /><span>Sign in to the AWS account that receives the bill. With AWS Organizations, the management account.</span></li>
          <li><Icon name="check" /><span>You can create CloudFormation stacks and IAM roles there.</span></li>
          <li>
            <Icon name="check" /><span
              >The stack runs in <strong>US East (N. Virginia), {facts.region}</strong>, where AWS delivers bill exports. The template refuses any
              other region.</span
            >
          </li>
          <li><Icon name="check" /><span>To cover member accounts too, Organizations needs all features on, not only consolidated billing.</span></li>
        </ul>
        <p class="note">Not you? Invite the colleague who has this access to your workspace as an admin, and send them this page.</p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="steps-title">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">ii.</span><span class="kicker">The steps</span></div>
      <div>
        <h2 id="steps-title">Three steps, <em>one</em> stack.</h2>
        <div class="steps" role="table" aria-label="Setup steps">
          <div class="row hdr" role="row">
            <span role="columnheader">No.</span><span role="columnheader">Step</span><span role="columnheader">You get</span><span
              role="columnheader">Time</span
            >
          </div>
          <div class="row" role="row" id="step-1">
            <span class="n" role="cell">1</span><span class="t" role="cell">{stepWorkspace}</span>
            <span class="art" role="cell"><Icon name="check" />Name and country set your currency</span>
            <span class="time" role="cell"><Icon name="clock" />{claims.workspaceTime}</span>
          </div>
          <div class="row" role="row" id="step-2">
            <span class="n" role="cell">2</span><span class="t" role="cell">{stepConnect}</span>
            <span class="art" role="cell"><Icon name="check" />{claims.stackName} · CREATE_COMPLETE</span>
            <span class="time" role="cell"><Icon name="clock" />~{claims.awsMinutes} min</span>
          </div>
          <div class="row" role="row">
            <span class="n" role="cell">3</span><span class="t" role="cell">{stepCheck}</span>
            <span class="art" role="cell"><Icon name="check" />A tick on every permission</span>
            <span class="time" role="cell"><Icon name="clock" />automatic</span>
          </div>
        </div>
        <h3 class="mt-l">Step 2, in AWS</h3>
        <ol class="ruled numbered">
          <li><span>In the same browser, sign in to the AWS account from the checklist.</span></li>
          <li>
            <span
              >Press <strong>Open AWS and connect</strong>. AWS opens the <code>{claims.stackName}</code> stack with every value filled in, under
              "Connection (pre-filled by Cloudoptics)".</span
            >
          </li>
          <li>
            <span
              >Tick the box that starts "I acknowledge" and choose <strong>Create stack</strong>. AWS asks because the stack creates IAM roles.</span
            >
          </li>
          <li><span>Come back to Cloudoptics. It moves on by itself when AWS is done.</span></li>
        </ol>
        <p class="muted small mt-s">No one-click link? Cloudoptics offers the template as a download, with the values to paste in.</p>
      </div>
    </div>
  </section>

  <section id="what-the-stack-creates" class="sec" aria-labelledby="what-the-stack-creates-title">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">iii.</span><span class="kicker">In your account</span></div>
      <div>
        <h2 id="what-the-stack-creates-title">What the stack creates</h2>
        <p class="sub">All of it lives in your account. Deleting the stack removes it, except the bucket.</p>
        <StackResources />
      </div>
    </div>
  </section>

  <section id="step-3" class="sec" aria-labelledby="step-3-title">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">iv.</span><span class="kicker">Step 3</span></div>
      <div>
        <h2 id="step-3-title">Cloudoptics checks <em>every</em> permission.</h2>
        <figure class="slip checks" aria-labelledby="checks-cap">
          <div class="slip-head"><b id="checks-cap">Access check</b><span class="tag-sample">Example</span></div>
          <ul>
            {
              claims.permissionChecks.map((c) => (
                <li>
                  <Icon name="check" />
                  {c}
                  <span class="ok">OK</span>
                </li>
              ))
            }
          </ul>
        </figure>
        <p class="sub mt-m">If a line fails, it says which part and why: a member account instead of the management account, or a bill export that has not arrived yet.</p>
      </div>
    </div>
  </section>

  <section id="afterwards" class="sec" aria-labelledby="afterwards-title">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">v.</span><span class="kicker">Afterwards</span></div>
      <div>
        <h2 id="afterwards-title">What you see, and <em>when</em>.</h2>
        <ol class="verify">
          <li class="vstep done">
            <span class="dot"><Icon name="server" /></span><span class="when">Within minutes</span><b>Accounts and recommendations</b>
            <span class="what">Once the first resource scan has run.</span>
          </li>
          <li class="vstep done">
            <span class="dot"><Icon name="receipt" /></span><span class="when">Within a day</span><b>Costs in USD and your currency</b>
            <span class="what">When AWS delivers the first bill export.</span>
          </li>
          <li class="vstep">
            <span class="dot"><Icon name="check" /></span><span class="when">Following weeks</span><b>Verified savings</b>
            <span class="what">As your changes show up in the bills.</span>
          </li>
        </ol>
        <p class="muted small mt-m">In an Organization, member accounts appear as the rollout reaches them.</p>
      </div>
    </div>
  </section>

  <section id="permissions" class="sec" aria-labelledby="permissions-title">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">vi.</span><span class="kicker">Permissions</span></div>
      <div>
        <h2 id="permissions-title">Two roles. <em>Read</em> actions only.</h2>
        <p class="sub">Every action, and the setup step's own role, is on the <a href="/security#permissions">security page</a>.</p>
        <div class="split">
          <div class="yes">
            <h3><Icon name="eye" />Reads · {readActionCount} actions</h3>
            <ul>{reads.map((r) => <li><Icon name={r.icon} />{r.label}<span class="count">{r.actions} {r.actions === 1 ? 'action' : 'actions'}</span></li>)}</ul>
          </div>
          <div class="no">
            <h3><Icon name="x" />Never</h3>
            <ul>{never.map((n) => <li><Icon name="x" />{n.replace(/\.$/, '')}</li>)}</ul>
          </div>
        </div>
        <p class="muted small mt-s">
          The roles are <code>{billingRole.roleName}</code> ({billingRole.actionCount} actions) and <code>{resourceRole.roleName}</code>
          ({resourceRole.actionCount} actions).
        </p>
        <p class="split-foot">
          <a class="text-link" href="/security#permissions">Every action, one by one <Icon name="arrow-right" /></a>
          <a class="text-link" href={TEMPLATE_URL}>Download the template <Icon name="download" /></a>
        </p>
      </div>
    </div>
  </section>

  <section id="aws-costs" class="sec" aria-labelledby="aws-costs-title">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">vii.</span><span class="kicker">AWS charges</span></div>
      <div>
        <h2 id="aws-costs-title">What it costs you in AWS</h2>
        <div class="body-copy">
          <p>
            AWS charges you for storing the bill export in your own bucket and for a few paid API calls, such as Cost Explorer at USD
            {claims.costExplorerRequestUsd.toFixed(2)} a request.
          </p>
          <p class="muted">We will publish a typical monthly figure once we have measured it with beta accounts.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="removing-access" class="sec" aria-labelledby="removing-access-title">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">viii.</span><span class="kicker">Leaving</span></div>
      <div>
        <h2 id="removing-access-title">Removing access</h2>
        <ul class="ruled">
          <li>
            <Icon name="trash" /><span
              >Delete the <code>{claims.stackName}</code> stack in CloudFormation ({facts.region}). Both roles, the bill export and, in an
              Organization, the member-account roles go with it.</span
            >
          </li>
          <li>
            <Icon name="activity" /><span
              >If a member account's role cannot be removed, the stack still deletes and your audit log records which accounts still have it.</span
            >
          </li>
          <li>
            <Icon name="bucket" /><span
              >The bucket <code>{facts.bucketName}</code> stays, so you keep your bills. Delete it yourself if you want them gone; files expire after
              {facts.exportExpiryDays} days anyway.</span
            >
          </li>
        </ul>
        <h3 class="mt-l" id="updating-access">Updating access</h3>
        <p class="body-copy">
          When we publish a new template version, the Connections page shows "Update CloudOptics access": a one-click, in-place update of the
          same stack. Your data is kept. Current version: {facts.templateVersion}.
        </p>
      </div>
    </div>
  </section>

  <Faq items={HOW_FAQ} title="Security questions" no="ix." />

  <section class="final" aria-labelledby="fin-h">
    <div class="wrap">
      <h2 id="fin-h">Ready when <em>you</em> are.</h2>
      <div>
        <div class="cta-row">
          <a class="btn btn-primary" href={START_URL}>Start free <Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href="/security">Security and permissions</a>
        </div>
        <p class="sign">Read-only · No card · Remove it any time</p>
      </div>
    </div>
  </section>
</Base>
