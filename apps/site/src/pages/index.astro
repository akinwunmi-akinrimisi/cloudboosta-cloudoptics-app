---
// Landing page (docs/14 §5.1) in design Direction A, "The Statement". Works fully without
// JavaScript; the currency toggle is the only script. Claims come from the claims file, the
// generated permission data (src/data/access.ts) and the demo's sample figures, always labelled.
import Faq from '../components/Faq.astro'
import Icon from '../components/Icon.astro'
import Slip from '../components/Slip.astro'
import { DEMO_URL, START_URL, claims } from '../config'
import { never, reads } from '../data/access'
import { LANDING_FAQ } from '../data/faq'
import { ledgerOther, ledgerTotal, sample } from '../data/sample'
import Base from '../layouts/Base.astro'

const title = 'Cloudoptics: your AWS bill in dollars and naira'
const description =
  'See your AWS bill in USD and your local currency, and know what is safe to cut. Read-only access, set up in about 15 minutes. Free during the beta.'

const software = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cloudoptics',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
  url: new URL('/', Astro.site).href,
  image: new URL('/og/cloudoptics.png', Astro.site).href,
  publisher: { '@id': new URL('/#organization', Astro.site).href },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: claims.pricing.headline },
}

const rate = claims.sampleRates.NGN
const usd = (n: number) => new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'USD', currencyDisplay: 'narrowSymbol', minimumFractionDigits: 2 }).format(n)
const ngn = (n: number) =>
  new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'NGN', currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 }).format(n * rate)

const included = [
  'Costs in USD and local currency',
  'Every recommendation type',
  'Verified savings',
  'Budgets, alerts, monthly report',
  'Your whole AWS Organization',
]
---

<Base title={title} description={description} jsonLd={[software]} faq={LANDING_FAQ}>
  <section class="hero" aria-labelledby="h1">
    <div class="wrap">
      <div>
        <span class="kicker">For African teams on AWS</span>
        <h1 id="h1">Your AWS bill in dollars and <span class="hl"><em>naira</em></span>. And what’s safe to cut.</h1>
        <ul class="lede" aria-label="In short">
          <li><Icon name="check" />Read-only</li>
          <li><Icon name="check" />About {claims.setupMinutes} minutes to set up</li>
          <li><Icon name="check" />Remove it any time</li>
        </ul>
        <div class="cta-row">
          <a class="btn btn-primary" href={START_URL}>Start free <Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href={DEMO_URL}>Explore the sample workspace</a>
        </div>
      </div>
      <Slip caption={`${sample.tenant} · this month`} figures={sample.hero} />
    </div>
  </section>

  <section class="sec" id="how" aria-labelledby="how-h">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">i.</span><span class="kicker">How it works</span></div>
      <div>
        <h2 id="how-h">One stack in AWS. <em class="nowrap">Read-only</em> from the first minute.</h2>
        <ol
          class="flow"
          aria-label="Your AWS account gets one stack with two read-only roles. Cloudoptics reads through them every day and shows savings in dollars and your currency."
        >
          <li class="node"><Icon name="cloud" /><b>Your AWS account</b><span class="mono">the one that gets the bill</span></li>
          <li class="arrow" aria-hidden="true">
            <svg viewBox="0 0 64 24"><path d="M2 12h56M50 5l8 7-8 7" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
            <span>1 click</span>
          </li>
          <li class="node"><Icon name="lock" /><b>Two read-only roles</b><span class="mono">{claims.stackName}</span></li>
          <li class="arrow" aria-hidden="true">
            <svg viewBox="0 0 64 24"><path d="M2 12h56M50 5l8 7-8 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4"></path></svg>
            <span>reads only</span>
          </li>
          <li class="node dark"><Icon name="eye" /><b>Cloudoptics</b><span class="mono">costs · resources · usage</span></li>
          <li class="arrow" aria-hidden="true">
            <svg viewBox="0 0 64 24"><path d="M2 12h56M50 5l8 7-8 7" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
            <span>daily</span>
          </li>
          <li class="node end"><Icon name="receipt" /><b>Savings in $ and ₦</b><span class="mono">ranked by how safe</span></li>
        </ol>

        <div class="steps" role="table" aria-label="Setup steps">
          <div class="row hdr" role="row">
            <span role="columnheader">No.</span><span role="columnheader">Step</span><span role="columnheader">You get</span><span
              role="columnheader">Time</span
            >
          </div>
          <div class="row" role="row">
            <span class="n" role="cell">1</span><span class="t" role="cell">Connect read-only</span>
            <span class="art" role="cell"><Icon name="check" />{claims.stackName} · CREATE_COMPLETE</span>
            <span class="time" role="cell"><Icon name="clock" />~{claims.awsMinutes} min in AWS</span>
          </div>
          <div class="row" role="row">
            <span class="n" role="cell">2</span><span class="t" role="cell">See costs in both currencies</span>
            <span class="art" role="cell"><Icon name="check" />{claims.permissionChecks[1]}</span>
            <span class="time" role="cell"><Icon name="clock" />within a day</span>
          </div>
          <div class="row" role="row">
            <span class="n" role="cell">3</span><span class="t" role="cell">Act safely, then see it in the bill</span>
            <span class="art" role="cell"><Icon name="undo" />risk, evidence, undo steps</span>
            <span class="time" role="cell"><Icon name="clock" />next bill</span>
          </div>
        </div>
        <a class="text-link mt-s" href="/how-it-works">Every step, in detail <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <section class="sec" id="ledger" aria-labelledby="led-h">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">ii.</span><span class="kicker">Savings, both currencies</span></div>
      <div>
        <h2 id="led-h">Every saving, priced in <em>your</em> currency.</h2>
        <p class="ledger-cap" id="led-cap">Savings found · {sample.tenant} <span class="tag-sample">Sample data</span></p>
        <table class="ledger" aria-labelledby="led-cap">
          <thead>
            <tr><th scope="col">Recommendation</th><th scope="col">Risk</th><th scope="col" class="r">USD / month</th><th scope="col" class="r">NGN / month</th></tr>
          </thead>
          <tbody>
            {
              sample.ledger.map((l) => (
                <tr class={l.highlight ? 'hl' : undefined}>
                  <th scope="row">
                    {l.title}
                    <span class="risk m-risk">
                      <svg viewBox="0 0 50 8" aria-hidden="true"><rect class="bg" x="0.5" y="0.5" width="49" height="7"></rect><rect class="fg" x="0.5" y="0.5" width={(49 * l.risk) / 100} height="7"></rect></svg>
                      Risk {l.risk}
                    </span>
                  </th>
                  <td class="risk-col">
                    <span class="risk">
                      <svg viewBox="0 0 50 8" aria-hidden="true"><rect class="bg" x="0.5" y="0.5" width="49" height="7"></rect><rect class="fg" x="0.5" y="0.5" width={(49 * l.risk) / 100} height="7"></rect></svg>
                      {l.risk}
                    </span>
                  </td>
                  <td class="r">{usd(l.usd)}</td>
                  <td class="r">{ngn(l.usd)}</td>
                </tr>
              ))
            }
            <tr>
              <th scope="row">Other recommendations</th>
              <td class="risk-col"></td>
              <td class="r">{usd(ledgerOther)}</td>
              <td class="r">{ngn(ledgerOther)}</td>
            </tr>
          </tbody>
          <tfoot>
            <tr><th scope="row">Total a month</th><td class="risk-col"></td><td class="r">{usd(ledgerTotal)}</td><td class="r">{ngn(ledgerTotal)}</td></tr>
          </tfoot>
        </table>
        <ul class="notes">
          <li><Icon name="activity" />Risk 0–100</li>
          <li><Icon name="undo" />Undo steps on every line</li>
          <li><Icon name="external" />Opens in the AWS console</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sec" id="security" aria-labelledby="sec-h">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">iii.</span><span class="kicker">Read-only by design</span></div>
      <div>
        <h2 id="sec-h">It can read. It can’t <em>change</em> anything.</h2>
        <div class="split">
          <div class="yes">
            <h3><Icon name="eye" />Reads</h3>
            <ul>
              {
                reads.map((r) => (
                  <li>
                    <Icon name={r.icon} />
                    {r.label}
                    <span class="count">{r.actions} {r.actions === 1 ? 'action' : 'actions'}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="no">
            <h3><Icon name="x" />Never</h3>
            <ul>
              {
                never.map((n) => (
                  <li>
                    <Icon name="x" />
                    {n.replace(/\.$/, '')}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="split-foot">
          <p><Icon name="trash" />Delete one stack and the access is gone.</p>
          <div class="links">
            <a class="text-link" href="/security#permissions">Read every permission <Icon name="arrow-right" /></a>
            <a class="text-link" href="/how-it-works#what-the-stack-creates">What the stack creates <Icon name="arrow-right" /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="verified" aria-labelledby="ver-h">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">iv.</span><span class="kicker">Verified savings</span></div>
      <div>
        <h2 id="ver-h">A saving counts when your <em>bill</em> shows it.</h2>
        <ol class="verify">
          <li class="vstep done">
            <span class="dot"><Icon name="eye" /></span><span class="when">Found</span><b>Estimate</b>
            <span class="amt">{usd(sample.rec.usd)} / {ngn(sample.rec.usd)}</span>
          </li>
          <li class="vstep done">
            <span class="dot"><Icon name="check" /></span><span class="when">You act</span><b>Change seen in AWS</b>
            <span class="amt">{sample.rec.check}</span>
          </li>
          <li class="vstep">
            <span class="dot"><Icon name="receipt" /></span><span class="when">Next bills</span><b>Measured from the bill</b>
            <span class="stamp">Verified</span>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="sec" id="pricing" aria-labelledby="pr-h">
    <div class="wrap sec-grid">
      <div class="margin"><span class="no" aria-hidden="true">v.</span><span class="kicker">Pricing</span></div>
      <div>
        <h2 id="pr-h">{claims.pricing.headline}.</h2>
        <div class="invoice">
          <div class="left">
            <span class="kicker">Included</span>
            <ul>
              {
                included.map((i) => (
                  <li>
                    <span>{i}</span>
                    <span>
                      <Icon name="check" />
                      <span class="sr-only">included</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="right">
            <div class="due">
              <span class="kicker">Amount due</span>
              <p class="big">$0<small>/ ₦0</small></p>
              <p>No card needed. Notice before any paid plan.</p>
            </div>
            <a class="btn btn-primary" href={START_URL}>Start free <Icon name="arrow-right" /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq items={LANDING_FAQ} no="vi." />

  <section class="final" aria-labelledby="fin-h">
    <div class="wrap">
      <h2 id="fin-h">Connect your first account in about <em>{claims.setupMinutes} minutes</em>.</h2>
      <div>
        <div class="cta-row">
          <a class="btn btn-primary" href={START_URL}>Start free <Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href="/how-it-works">How it works</a>
        </div>
        <p class="sign">Read-only · No card · Remove it any time</p>
      </div>
    </div>
  </section>
</Base>
