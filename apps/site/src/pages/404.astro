---
// A real 404 page (docs/14 §4.1): static hosts serve 404.html with status 404, and it is never
// indexed. Old app paths from emails and bookmarks (/overview) are forwarded to /app/... by
// public/legacy-redirect.js before the page renders (SITE-13).
import Icon from '../components/Icon.astro'
import { START_URL } from '../config'
import Base from '../layouts/Base.astro'
---

<Base title="Page not found | Cloudoptics" description="This page does not exist. Find how Cloudoptics works, its security and permissions, or start free." noindex>
  <script is:inline slot="head" src="/legacy-redirect.js"></script>
  <section class="lost" aria-labelledby="h1">
    <div class="wrap">
      <div>
        <span class="kicker">Error 404</span>
        <h1 id="h1">No such <em>page</em>.</h1>
        <p class="intro">The link may be old or mistyped.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={START_URL}>Start free <Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href="/">Home</a>
        </div>
      </div>
      <nav class="slip" aria-labelledby="lost-cap">
        <div class="slip-head"><b id="lost-cap">Try instead</b><span class="tag-sample">404</span></div>
        <div class="toc">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/how-it-works">How it works</a></li>
            <li><a href="/security">Security and permissions</a></li>
            <li><a href="/#pricing">Pricing</a></li>
          </ol>
        </div>
      </nav>
    </div>
  </section>
</Base>
