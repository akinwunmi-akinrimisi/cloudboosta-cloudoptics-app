---
// A real 404 page (docs/14 §4.1): static hosts serve 404.html with status 404, and it is never
// indexed. SITE-13 adds the redirect map for old app paths (/overview → /app/overview).
import { START_URL } from '../config'
import Base from '../layouts/Base.astro'
---

<Base title="Page not found | Cloudoptics" description="This page does not exist. Find how Cloudoptics works, its security and permissions, or start free." noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold text-link">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">We could not find that page</h1>
    <p class="mt-4 text-secondary">The link may be old or mistyped. These pages might help:</p>
    <ul class="mt-6 flex flex-wrap justify-center gap-3">
      <li><a class="inline-flex min-h-11 items-center rounded-sm border border-border-strong bg-surface-1 px-4 font-medium" href="/">Home</a></li>
      <li><a class="inline-flex min-h-11 items-center rounded-sm border border-border-strong bg-surface-1 px-4 font-medium" href="/how-it-works">How it works</a></li>
      <li><a class="inline-flex min-h-11 items-center rounded-sm border border-border-strong bg-surface-1 px-4 font-medium" href="/security">Security</a></li>
      <li><a class="inline-flex min-h-11 items-center rounded-sm bg-accent px-4 font-semibold text-on-accent" href={START_URL}>Start free</a></li>
    </ul>
  </section>
</Base>
